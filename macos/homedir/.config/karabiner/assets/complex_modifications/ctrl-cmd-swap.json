{
  "title": "Swap Command and Control (except terminals)",
  "rules": [
    {
      "description": "Swap Command and Control except in Terminal, iTerm2, CRD PWA, and Royal TSX",
      "manipulators": [
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.apple\\.Terminal$",
                "^com\\.apple\\.iTerm2$",
                "^com\\.google\\.Chrome\\.app\\.cmkncekebbebpfilplodngbpllndjkfo$",
                "^com\\.lemonmojo\\.RoyalTSX\\.App$"
              ],
              "type": "frontmost_application_unless"
            }
          ],
          "from": {
            "key_code": "left_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "left_control" }],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.apple\\.Terminal$",
                "^com\\.apple\\.iTerm2$",
                "^com\\.google\\.Chrome\\.app\\.cmkncekebbebpfilplodngbpllndjkfo$",
                "^com\\.lemonmojo\\.RoyalTSX\\.App$"
              ],
              "type": "frontmost_application_unless"
            }
          ],
          "from": {
            "key_code": "left_control",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "left_command" }],
          "type": "basic"
        }
      ]
    }
  ]
}
